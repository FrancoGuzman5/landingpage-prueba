// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tour {
  id             Int      @id @default(autoincrement())
  slug           String   @unique          // URL amigable: /tours/san-pedro
  title          String
  description    String
  location       String
  image          String?                   // foto principal (tarjeta)
  durationDays   Int
  price          Float
  priceOriginal  Float?                     // precio tachado (oferta)
  motivoDescuento String?                   // por qué hay descuento (ej. "Precio de lanzamiento").
                                            // Sin motivo NO se muestra el precio tachado: un precio
                                            // anterior sin razón es publicidad engañosa.
  cuotas         Int?                       // nº de cuotas sin interés. null = no se ofrece todavía
  startDate      DateTime
  endDate        DateTime
  difficulty     String?
  language       String?
  capacityMin    Int?                       // opcional: el dossier no siempre lo trae
  capacityMax    Int?
  includes       String[]  @default([])     // lista de items incluidos
  notIncluded    String[]  @default([])     // lista de items no incluidos
  focus          String?   // espiritual, cultural, etc.
  tipo           String?   // terreno/actividad para el chip de la tarjeta: "Desierto", "Trekking".
                           // Es otro eje que `focus` (que es el enfoque temático).
  cuposDisponibles Int?    // cupos que quedan en la próxima salida. La fecha de esa
                           // salida es `startDate`; la exigencia se deriva de `difficulty`.
  attractions    Json?                      // [{ titulo, descripcion, foto?, pieDeFoto? }]
  itinerario     Json?                      // [{ dia, titulo, descripcion }] día a día.
                                            // null → la ficha no muestra la sección
  accommodation  Json?                      // { nombre, descripcion, amenities[] }
  publicado      Boolean   @default(true)    // false = borrador: se puede preparar una ruta
                                             // sin que aparezca en la web. Por defecto true
                                             // para que las que ya existen sigan visibles.
  createdAt      DateTime  @default(now())
  // El @default(now()) no es decorativo: sin él, la migración intentaría crear
  // una columna NOT NULL sin valor y fallaría en las filas que ya existen.
  updatedAt      DateTime  @default(now()) @updatedAt

  bookings Booking[]
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  phone     String?
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Recuperación de contraseña.
  //
  // Se guarda el HASH del token, nunca el token: si la base se filtrara, con
  // el token en claro cualquiera podría cambiar contraseñas ajenas. Es el
  // mismo principio que con las contraseñas.
  //
  // Campos en el usuario y no una tabla aparte a propósito: hay a lo sumo un
  // token vivo por cuenta. Pedir otro enlace pisa el anterior, así que el
  // enlace viejo deja de funcionar solo — sin tener que limpiarlo.
  resetTokenHash   String?   @unique
  resetTokenExpira DateTime?

  bookings  Booking[]
}

enum Role {
  USER
  ADMIN
}

model Booking {
  id          Int      @id @default(autoincrement())
  userId      Int?                       // opcional: la reserva puede ser de un invitado
  tourId      Int
  reservedAt  DateTime @default(now())
  quantity    Int                        // cantidad de personas
  status      BookingStatus @default(PENDING)

  // Datos de contacto de la reserva (snapshot al momento de reservar).
  // Se llenan siempre: de la cuenta si está logueado, o del formulario si es invitado.
  contactName   String?
  contactEmail  String?
  contactPhone  String?

  user        User?    @relation(fields: [userId], references: [id])
  tour        Tour     @relation(fields: [tourId], references: [id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
